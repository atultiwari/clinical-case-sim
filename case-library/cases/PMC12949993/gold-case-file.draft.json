  "ground_truth": {
    "final_diagnosis": {
      "text": "Lead poisoning from an unlabelled herbal supplement, presenting with abdominal pain and anaemia with coarse basophilic stippling and ring sideroblasts",
      "icd10": ["T56.0", "D64.2"],
      "accepted_synonyms": ["lead toxicity", "lead poisoning", "plumbism", "saturnism", "lead intoxication", "heavy-metal (lead) poisoning"]
    },
    "secondary_findings": [
      "Weakly positive IgG-only DAT, most likely passive antibody from IVIG rather than warm autoimmune haemolytic anaemia",
      "Agglutination on the film and a cold agglutinin titre of 32 with low thermal amplitude: not clinically significant",
      "Raised CK explained by inclusion body myositis"
    ],
    "accepted_differential": [
      "Warm autoimmune haemolytic anaemia",
      "IVIG-associated haemolysis or passive DAT positivity",
      "Drug-induced anaemia (mycophenolate)",
      "Myelodysplastic neoplasm with ring sideroblasts",
      "Other acquired sideroblastic anaemia (copper deficiency, alcohol, isoniazid)",
      "Arsenic or mercury toxicity",
      "Acute porphyria",
      "Thalassaemia trait (basophilic stippling)"
    ],
    "red_herrings": ["IgG 1+ DAT", "film agglutination", "cold agglutinin titre 32", "atypical plasma cells", "raised polyclonal free light chains", "mild transaminase rise", "raised CK"],
    "key_discriminators": ["coarse basophilic stippling", "Pappenheimer bodies", "ring sideroblasts", "normal MCV with reticulocytosis", "supplement history", "blood lead 77.8 ug/dL"],
    "treatment_given": "Oral succimer (DMSA) after clinical toxicology consultation. Public health investigation confirmed the supplement as the source of lead, with mercury and arsenic also reported.",
    "outcome": "Progressive haematological recovery and symptomatic improvement. Follow-up values not reported.",
    "must_do": [
      "Ask specifically about supplements, herbal, traditional or imported medicines and over-the-counter products",
      "Have the peripheral blood film reviewed for basophilic stippling",
      "Measure venous blood lead",
      "Stop the exposure before or alongside chelation",
      "Chelate with oral succimer (symptomatic, blood lead about 78 ug/dL), with clinical toxicology input",
      "Notify public health, arrange testing of the product and ask who else took it",
      "Plan a repeat blood lead after chelation, because levels rebound"
    ],
    "must_not_do": [
      "Escalate immunosuppression for presumed warm AIHA on a weak IgG-only DAT in a patient on IVIG without re-evaluating",
      "Label myelodysplasia with ring sideroblasts before excluding reversible causes such as lead, copper deficiency, alcohol and drugs",
      "Chelate while the exposure continues",
      "Start empirical iron therapy (iron studies are replete; transferrin saturation 53%)"
    ],
    "diagnosis_rubric_anchors": {
      "5": "Lead poisoning, with the herbal supplement identified as the source",
      "4": "Lead poisoning, source not identified",
      "3": "Heavy-metal poisoning without naming lead, or toxic sideroblastic anaemia without naming lead",
      "2": "Warm AIHA, IVIG-related haemolysis, MDS with ring sideroblasts or drug-induced anaemia as the final diagnosis",
      "1": "Unrelated diagnosis, or one that would lead to harm"
    }
  },

