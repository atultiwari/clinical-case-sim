# Case Library settings. Copy to .env (git-ignored) and fill in. Never commit real values.
# Scripts read them with: uv run --env-file .env python scripts/<script>.py

# Read-only role on the Case Vault (Supabase project case-vault), session pooler URL.
CASE_VAULT_DB_URL_READONLY=

# Nightly backup (scripts/backup_case_vault.py): the admin connection, session pooler (port 5432).
# Never use this URL in other scripts; they read the read-only one above.
CASE_VAULT_DB_URL_BACKUP=
# Optional: where backups go (default ~/CaseVaultBackups). Keep it outside the repository.
CASE_VAULT_BACKUP_DIR=

# NCBI E-utilities: 10 requests per second with a key, 3 without.
NCBI_API_KEY=
NCBI_EMAIL=

# Atul only: a write-capable login for scripts/vault_load.py, which runs loads too
# large for the connector. Never commit it and never paste it in a chat.
CASE_VAULT_DB_URL_OWNER=
