# Case Library settings. Copy to .env (git-ignored) and fill in. Never commit real values.
# Scripts read them with: uv run --env-file .env python scripts/<script>.py

# Read-only role on the Case Vault (Supabase project case-vault), session pooler URL.
CASE_VAULT_DB_URL_READONLY=

# NCBI E-utilities: 10 requests per second with a key, 3 without.
NCBI_API_KEY=
NCBI_EMAIL=
