<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly Case Vault backup at 02:30 local time (PLAN L0.3). Install with
     scripts/launchd/install_backup_agent.sh; it runs at the next wake if the Mac was asleep. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.clinical-case-sim.casevault-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>CASE_LIBRARY_PATH/scripts/launchd/nightly_backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardErrorPath</key>
  <string>HOME_PATH/CaseVaultBackups/launchd.err</string>
</dict>
</plist>
