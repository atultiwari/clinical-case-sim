# Case Studio. Copy to .env.local (git-ignored), or keep the same line in case-library/.env.
# Read-only connection to the Case Vault. The Studio sets role casevault_reader and
# read-only transactions itself, so the local superuser URL is safe to use locally:
#   postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Never commit a real cloud URL or paste it in a chat.
CASE_VAULT_DB_URL_READONLY=
