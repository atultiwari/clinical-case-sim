# Case Studio. Copy to .env.local (git-ignored). The two database URLs may instead
# live in case-library/.env. Never commit real values or paste them in a chat.

# Read-only connection to the Case Vault. The Studio sets role casevault_reader and
# read-only transactions itself, so the local superuser URL is safe to use locally:
#   postgresql://postgres:postgres@127.0.0.1:55322/postgres
CASE_VAULT_DB_URL_READONLY=

# v2 only: the writer's connection (a login role in casevault_studio_writer). Each
# write switches to that role in its own transaction. Locally the superuser URL above.
CASE_VAULT_DB_URL_STUDIO_WRITER=

# v2 only: the login. Leave STUDIO_USERS empty to run as v1 (read-only, no login,
# localhost only). Entries come from `pnpm --filter @case-library/studio hash-password
# <username> --dotenv` (in this file every $ must be written \$).
STUDIO_USERS=
# At least 32 bytes, e.g. `openssl rand -base64 48`. Required when STUDIO_USERS is set.
STUDIO_SESSION_SECRET=
