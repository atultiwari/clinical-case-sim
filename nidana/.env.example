# Nidana game server (apps/server). Copy to .env.local; never commit real values.

# Where published bundles come from: "files" (case-library/exports, development) or "database" (the Case Vault).
NIDANA_BUNDLE_SOURCE=files
# Where play data goes: "memory" (local only; refused in production) or "database" (the play schema).
NIDANA_STORE=memory

# The nidana_server login role's URL (supabase/proposed/20260926190000_play_schema.sql). Needed for "database".
DATABASE_URL=

# Sign-in checks: the Supabase project URL (JWKS), or the project's JWT secret (local stack, legacy keys).
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Optional path overrides (defaults follow the monorepo layout).
# NIDANA_EXPORTS_DIR=
# NIDANA_CATALOGUE_PATH=
# NIDANA_CONFIG_DIR=
