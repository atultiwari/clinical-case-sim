# Nidana player app. Copy to .env.local for local development. Values are inlined into the app at
# build time, so nothing here may be secret (the Supabase publishable key is public by design).

# The game server (apps/server). From the Android emulator, the Mac's localhost is 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:3100

# The Case Vault project's Supabase URL and publishable key (sb_publishable_...), for anonymous sign-in.
EXPO_PUBLIC_SUPABASE_URL=https://vxiymbaxsiavxuyxzhnt.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=
