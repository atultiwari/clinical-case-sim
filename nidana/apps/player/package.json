{
  "name": "@nidana/player",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-css-interop": "0.2.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.13",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "jose": "6.2.12",
    "@nidana/contracts": "workspace:*"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "lint": "eslint . && prettier --check . --ignore-path ../../../.gitignore --ignore-path .gitignore",
    "format": "prettier --write . --ignore-path ../../../.gitignore --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "private": true,
  "description": "Nidana's player app (Expo: Android, iOS and the web). It talks only to the game server; nothing case-specific ships inside it."
}
