# The web build of Nidana's player app (N1.8), served by nginx. Build from the repository root:
#   docker build -f nidana/apps/player/Dockerfile.web \
#     --build-arg EXPO_PUBLIC_API_URL=https://<game server> \
#     --build-arg EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co \
#     --build-arg EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_... -t nidana-web .
# The three values are public by design and are inlined into the JavaScript at build time.

FROM node:22-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH EXPO_NO_TELEMETRY=1 CI=1
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY case-library/studio/package.json case-library/studio/
COPY nidana/apps/server/package.json nidana/apps/server/
COPY nidana/tsconfig.base.json nidana/
COPY nidana/packages nidana/packages
COPY nidana/apps/player nidana/apps/player
RUN pnpm install --frozen-lockfile --filter "@nidana/player..."
ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_SUPABASE_URL
ARG EXPO_PUBLIC_SUPABASE_KEY
RUN test -n "$EXPO_PUBLIC_API_URL" && test -n "$EXPO_PUBLIC_SUPABASE_URL" && test -n "$EXPO_PUBLIC_SUPABASE_KEY" \
  || (echo "Set the three EXPO_PUBLIC_* build arguments" && exit 1)
WORKDIR /app/nidana/apps/player
RUN EXPO_PUBLIC_API_URL="$EXPO_PUBLIC_API_URL" \
    EXPO_PUBLIC_SUPABASE_URL="$EXPO_PUBLIC_SUPABASE_URL" \
    EXPO_PUBLIC_SUPABASE_KEY="$EXPO_PUBLIC_SUPABASE_KEY" \
    npx expo export --platform web --clear

FROM nginx:1.29-alpine AS run
COPY nidana/apps/player/nginx.conf /etc/nginx/conf.d/default.conf
COPY nidana/apps/player/nginx-security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /app/nidana/apps/player/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
