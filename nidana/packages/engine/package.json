{
  "name": "@nidana/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Nidana's engine: pure functions that replay a case bundle and a player's action log. Imported only by the game server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . --ignore-path ../../../.gitignore",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nidana/contracts": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^22",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
