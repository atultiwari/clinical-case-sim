# Sambhasha settings. Copy to .env (git-ignored) and fill in. Never commit real values.

# Google's Gemini API (free tier), for the pilot (D-028). Get a key in Google AI Studio.
GEMINI_API_KEY=

# OpenRouter, for cloud models later (configs/models.openrouter.yaml). Model ids live in
# configs/*.yaml, not here.
OPENROUTER_API_KEY=

# Ollama, for local models.
OLLAMA_BASE_URL=http://localhost:11434/v1

# The run database. Leave empty for the local one from `supabase db start`
# (postgresql://postgres:postgres@127.0.0.1:56322/postgres). Never the Case Vault.
SUPABASE_DB_URL=
