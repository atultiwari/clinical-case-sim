# Sambhasha settings. Copy to .env (git-ignored) and fill in. Never commit real values.

# OpenRouter, for cloud models (SPEC §11). Model ids live in configs/models.yaml, not here.
OPENROUTER_API_KEY=

# Ollama, for local models.
OLLAMA_BASE_URL=http://localhost:11434/v1

# The run database: local Supabase from `supabase start` (task P0.3). Never the Case Vault.
SUPABASE_DB_URL=
